{
  "name": "ariadne-tears-in-the-rain",
  "version": "0.1.0",
  "private": true,
  "description": "ARIADNE: Tears in the Rain. A guided interactive documentary about the machines NASA left on the Moon, on Mars and beyond. NASA Space Apps Challenge 2026. Code written with AI assistance (see README).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "dev": "npm run content && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "check": "npm run content && tsc --noEmit && vitest run && vite build && tsx scripts/check-dist.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
